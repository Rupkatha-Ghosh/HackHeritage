{
  "name": "orca-x",
  "private": true,
  "version": "1.0.0",
  "description": "ORCA-X marine intelligence platform — HackHeritage",
  "type": "module",
  "scripts": {
    "dev": "tsx server/app.ts",
    "dev:ml": "uvicorn ml.api:app --reload --host 0.0.0.0 --port 8000",
    "dev:rag": "uvicorn ml.rag_api:app --reload --host 0.0.0.0 --port 8001",
    "ingest:rag": "tsx scripts/ingest-rag.mjs",
    "analyze:realtime": "python ml/src/analyze_realtime_source_bias.py",
    "verify:realtime": "node scripts/verify-marine-sources.mjs",
    "build": "vite build && esbuild server/app.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node -e \"process.env.ORCA_PRODUCTION='true'; require('./dist/server.cjs')\"",
    "start:ml": "uvicorn ml.api:app --host 0.0.0.0 --port 8000",
    "start:rag": "uvicorn ml.rag_api:app --host 0.0.0.0 --port 8001",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "animejs": "^4.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
