# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Copernicus Data Space STAC catalogue endpoint.
COPERNICUS_STAC_URL="https://stac.dataspace.copernicus.eu/v1"

# ORCA-X Refinement 2 ML service.
# FastAPI ML server runs separately from the TypeScript application.
ORCA_ML_API_URL="http://127.0.0.1:8000"
ORCA_ML_API_TIMEOUT_MS="3500"
